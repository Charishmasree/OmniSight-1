# ============================================================================
# OmniSight Member 2 - Environment Configuration
# ============================================================================

# Google Gemini API Key (Get a free key at: https://aistudio.google.com/)
# Paste your Gemini API key below if you have one:
GEMINI_API_KEY=

# Vision-Language Model name (default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
VLM_MODEL_NAME=gemini-2.5-flash

# Mock Mode (true / false)
# Set to true for offline testing without an API key.
# Set to false when you have pasted your GEMINI_API_KEY above.
VLM_MOCK_MODE=true

# Default directory where analysis JSON reports will be saved
VLM_OUTPUT_DIR=analysis_reports

